# PostgreSQL connection string (Neon / Render Postgres)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Internal Rust backend bind address (kept private inside container)
BACKEND_ADDR=127.0.0.1:8080

# Next.js server target for internal backend proxy
BACKEND_INTERNAL_URL=http://127.0.0.1:8080

# Long random secrets (keep ENCRYPTION_KEY permanent!)
APP_SECRET=replace-with-long-random-app-secret
ENCRYPTION_KEY=replace-with-long-random-encryption-key
ADMIN_TOKEN=replace-with-long-random-admin-token

# Session lifecycle
SESSION_TTL_SECONDS=90
CLEANUP_INTERVAL_SECONDS=30

# Railway slot deployment defaults
RAILWAY_CLI_PATH=railway
SLOT_WORK_ROOT=/tmp/nekotunnel-railway-slots
SERVICE_NAME=final
TCP_INTERNAL_PORT=8080
FRP_VERSION=0.57.0
